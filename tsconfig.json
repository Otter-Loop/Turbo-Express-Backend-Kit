{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "./drizzle.config.ts"]
}