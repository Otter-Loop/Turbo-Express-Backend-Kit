{
  "name": "backend-kit",
  "version": "1.0.0",
  "description": "Backend development kit",
  "main": "dist/index.js",
  "type": "module",
  "lint-staged": {
    "**/*": "bunx prettier --write --ignore-unknown"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap",
    "start": "NODE_ENV=production bun ./dist/index.js",
    "cli": "bun ./src/scripts/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "auth:generate": "bunx @better-auth/cli generate --config ./src/lib/auth/index.ts --output ./src/schema/auth.ts",
    "db:studio": "bunx drizzle-kit studio --port=3000",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.5",
    "@scalar/express-api-reference": "^0.8.48",
    "better-auth": "^1.5.4",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "react-email": "^5.2.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "3.7.4",
    "typescript": "^5.9.3"
  }
}
