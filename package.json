{
  "name": "backend-kit",
  "version": "1.0.0",
  "description": "Backend development kit",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "dev": "tsx watch ./src/index.ts --host 0.0.0.0",
    "build": "node build.mjs",
    "start": "set NODE_ENV=production && node ./dist/index.js",
    "drizzle-studio": "npx drizzle-kit studio --port=3000",
    "cli": "tsx ./src/scripts/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "better-auth-generate": "npx @better-auth/cli generate --config ./src/lib/auth/index.ts --output ./src/schema/auth.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@react-email/components": "^1.0.2",
    "@react-email/render": "^2.0.0",
    "@react-email/tailwind": "^2.0.2",
    "@scalar/express-api-reference": "^0.8.30",
    "better-auth": "^1.4.5",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "react-email": "^5.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "drizzle-kit": "^0.31.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
